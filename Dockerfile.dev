FROM php:8.2-fpm-alpine

ARG DEV_MODE=true

# Install system dependencies
RUN apk add --no-cache \
    postgresql-client \
    postgresql-dev \
    wget \
    git \
    curl \
    zip \
    unzip \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    gmp-dev \
    icu-dev \
    zlib-dev \
    libzip-dev \
    vim \
    nano \
    htop \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
    gd \
    pdo_pgsql \
    pgsql \
    gmp \
    intl \
    zip \
    opcache

# Note: Xdebug skipped on arm64 (requires compilation)
# For debugging, use VSCode remote debugging or other IDE features

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /opt/drupal

# Copy PHP configuration first
COPY docker/php/php-dev.ini /usr/local/etc/php/php.ini
COPY docker/php/php-fpm-dev.conf /usr/local/etc/php-fpm.d/www.conf

# Create directory structure for volumes
RUN mkdir -p web/modules/custom web/themes/custom && \
    chown -R www-data:www-data /opt/drupal

# Set proper permissions
RUN chmod 755 /opt/drupal

EXPOSE 9000

CMD ["php-fpm"]
